---
/**
 * Inline SVG icons for the site chrome.
 *
 * Brand marks (GitHub, LinkedIn, ResearchGate, X, Facebook) are left to Font
 * Awesome, which is loaded once in the head — those paths are long and easy to
 * get subtly wrong. Everything structural is drawn here so it stays crisp and
 * needs no icon font.
 *
 * All paths use a 24×24 viewBox and are stroked unless noted.
 */
type IconName =
	| 'search'
	| 'close'
	| 'menu'
	| 'arrow-up'
	| 'arrow-right'
	| 'chevron-left'
	| 'chevron-right'
	| 'chevron-down'
	| 'share'
	| 'calendar'
	| 'clock'
	| 'tag';

type Props = {
	name: IconName;
	size?: number;
	stroke?: number;
	class?: string;
};

const { name, size = 18, stroke = 1.8, class: className = '' } = Astro.props;

const PATHS: Record<IconName, string> = {
	search: '<circle cx="11" cy="11" r="7.25"/><path d="m16.5 16.5 4 4"/>',
	close: '<path d="M18 6 6 18M6 6l12 12"/>',
	menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
	'arrow-up': '<path d="M12 19V5M5.5 11.5 12 5l6.5 6.5"/>',
	'arrow-right': '<path d="M4 12h15M13 6l6 6-6 6"/>',
	'chevron-left': '<path d="m14.5 18-6-6 6-6"/>',
	'chevron-right': '<path d="m9.5 18 6-6-6-6"/>',
	'chevron-down': '<path d="m6 9.5 6 6 6-6"/>',
	share:
		'<circle cx="18" cy="5.5" r="2.75"/><circle cx="6" cy="12" r="2.75"/><circle cx="18" cy="18.5" r="2.75"/><path d="m8.5 13.4 7 4.2M15.5 6.4l-7 4.2"/>',
	calendar:
		'<rect x="3.25" y="4.75" width="17.5" height="16" rx="2.5"/><path d="M16 2.75v4M8 2.75v4M3.25 10h17.5"/>',
	clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5.2l3.3 2"/>',
	tag: '<path d="M20.4 13.6 13.6 20.4a1.8 1.8 0 0 1-2.55 0L3.6 12.95V3.6h9.35l7.45 7.45a1.8 1.8 0 0 1 0 2.55Z"/><circle cx="7.9" cy="7.9" r="1.35"/>',
};
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={stroke}
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	class={className}
	set:html={PATHS[name]}
/>
